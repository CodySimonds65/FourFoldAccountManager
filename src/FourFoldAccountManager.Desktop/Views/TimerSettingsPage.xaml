<UserControl x:Class="FourFoldAccountManager.Desktop.Views.TimerSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FourFoldAccountManager.Desktop.Views"
             Focusable="True" PreviewKeyDown="TimerSettingsPage_PreviewKeyDown"
             PreviewMouseDown="TimerSettingsPage_PreviewMouseDown" PreviewMouseWheel="TimerSettingsPage_PreviewMouseWheel"
             LostKeyboardFocus="TimerSettingsPage_LostKeyboardFocus">
    <StackPanel>
        <views:ShortcutRow x:Name="SplitRow" Action="TimerSplit"
                           Title="Split" Description="Start the run, then record a lap on each press." />
        <views:ShortcutRow x:Name="FinishRow" Action="TimerFinish" Margin="0,10,0,0"
                           Title="Finish" Description="Record the final lap and stop the run." />
        <views:ShortcutRow x:Name="ResetRow" Action="TimerReset" Margin="0,10,0,0"
                           Title="Reset" Description="Clear the timer and all laps." />
        <TextBlock Margin="2,12,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                   Text="Click a key to change it. Esc cancels." />
    </StackPanel>
</UserControl>
