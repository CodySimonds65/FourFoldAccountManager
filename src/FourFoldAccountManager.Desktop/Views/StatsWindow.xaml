<Window x:Class="FourFoldAccountManager.Desktop.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FourFoldAccountManager.Desktop.Views"
        Title="FourFold stats" Width="480" Height="360" MinWidth="320" MinHeight="240"
        Icon="/Assets/FourFold.ico"
        Background="{DynamicResource Brush.AppBackground}" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1" Padding="10,7">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CardsButton" Content="Cards" Click="CardsButton_Click"
                        Style="{StaticResource AppButtonStyle}" Height="30" Padding="12,0"
                        ToolTip="Choose which cards show in this window" />
                <TextBlock Text="Drag a card to move it; drag its corner to resize it." Margin="12,0,0,0"
                           VerticalAlignment="Center" Style="{StaticResource QuietTextStyle}" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Background="{DynamicResource Brush.ClientBackground}">
            <TextBlock x:Name="EmptyText" Text="Use Cards to add XP/hr, Stats, XP calc, or the Timer."
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"
                       Style="{StaticResource QuietTextStyle}" />
            <views:OverlayCardLayer x:Name="CardLayer" />
        </Grid>
    </Grid>
</Window>
