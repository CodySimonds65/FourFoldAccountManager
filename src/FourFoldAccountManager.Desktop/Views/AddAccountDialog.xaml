<Window x:Class="FourFoldAccountManager.Desktop.Views.AddAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FourFold account" Width="480" Height="530" MinWidth="480" MinHeight="530"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.AppBackground}" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="YOUR FOURFOLD PARTY" FontSize="10" Foreground="{DynamicResource Brush.AccentGold}" Margin="0,0,0,9" />
            <TextBlock x:Name="DialogHeading" FontSize="24" FontWeight="SemiBold" Text="Add account" />
            <TextBlock x:Name="DialogPrompt" Margin="0,7,0,22" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                       Text="Set a profile label and optional saved login." />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Profile name" FontSize="12" Margin="0,0,0,7" />
            <TextBox x:Name="LabelBox" Height="40" MaxLength="60" VerticalContentAlignment="Center" Style="{StaticResource InputStyle}" />
            <TextBlock Text="SAVED LOGIN · OPTIONAL" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,22,0,12" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Username" FontSize="12" Margin="0,0,0,7" />
                    <TextBox x:Name="UsernameBox" Height="40" MaxLength="256" VerticalContentAlignment="Center" Style="{StaticResource InputStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Password" FontSize="12" Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordBox" Height="40" MaxLength="128" VerticalContentAlignment="Center"
                                 Style="{StaticResource PasswordInputStyle}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Save a login for one-click launch, or leave both fields blank to sign in yourself."
                       FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
        <TextBlock x:Name="ValidationText" Grid.Row="2" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,14,0,12" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Saved securely on this PC" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="78" Height="36" Margin="0,0,8,0" IsCancel="True" Content="Cancel" Style="{StaticResource AppButtonStyle}" />
                <Button Width="94" Height="36" IsDefault="True" Click="Save_Click" Content="Save profile" Padding="10,0" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>