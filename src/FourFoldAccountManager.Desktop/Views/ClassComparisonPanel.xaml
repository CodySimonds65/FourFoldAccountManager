<UserControl x:Class="FourFoldAccountManager.Desktop.Views.ClassComparisonPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:calc="clr-namespace:FourFoldAccountManager.Core.Calculation;assembly=FourFoldAccountManager.Core">
    <Border Style="{StaticResource SidebarCardStyle}" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="2,2,2,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                    <Image x:Name="ProfileImage" Stretch="UniformToFill" Visibility="Collapsed" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AccountText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ClassText" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="UpdatedText" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" Style="{StaticResource AppButtonStyle}"
                        Height="30" Padding="10,0" VerticalAlignment="Top" />
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Select an account to load its profile." TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextMuted}" Margin="2,0,2,10" />
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,12">
                <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="ABOVE" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock x:Name="AboveText" Text="—" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.AccentGreen}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="BELOW" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock x:Name="BelowText" Text="—" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Danger}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="7" Padding="8">
                    <StackPanel>
                        <TextBlock Text="MEAN DELTA" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock x:Name="MeanText" Text="—" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.AccentGold}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.85*" />
                        <ColumnDefinition Width="0.85*" />
                        <ColumnDefinition Width="0.85*" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="STAT" Style="{StaticResource QuietTextStyle}" />
                    <TextBlock Grid.Column="1" Text="PROFILE" Style="{StaticResource QuietTextStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="AVERAGE" Style="{StaticResource QuietTextStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="DELTA" Style="{StaticResource QuietTextStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="%" Style="{StaticResource QuietTextStyle}" HorizontalAlignment="Right" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RowsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="2,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="0.85*" />
                                            <ColumnDefinition Width="0.85*" />
                                            <ColumnDefinition Width="0.85*" />
                                            <ColumnDefinition Width="0.8*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatLabel}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProfileText}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding AverageText}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextMuted}" />
                                        <TextBlock Grid.Column="3" Text="{Binding DifferenceText}" HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="{x:Static calc:ComparisonDirection.Above}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentGreen}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="{x:Static calc:ComparisonDirection.Below}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" Text="{Binding PercentageText}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
