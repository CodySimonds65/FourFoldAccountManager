<UserControl x:Class="FourFoldAccountManager.Desktop.Views.PluginSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:FourFoldAccountManager.Core.Models;assembly=FourFoldAccountManager.Core"
             xmlns:views="clr-namespace:FourFoldAccountManager.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="2,2,2,12">
            <TextBlock Text="PLUGINS" FontSize="10" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.AccentGold}" />
            <TextBlock Text="Account tools" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Button x:Name="XpTrackerButton" Content="XP" Tag="{x:Static core:PluginKind.XpTracker}"
                    Click="PluginButton_Click" Style="{StaticResource AppButtonStyle}" Height="30" Padding="4,0" Margin="0,0,4,0"
                    ToolTip="XP Tracker" />
            <Button x:Name="ClassComparisonButton" Content="Stats" Tag="{x:Static core:PluginKind.ClassComparison}"
                    Click="PluginButton_Click" Style="{StaticResource AppButtonStyle}" Height="30" Padding="4,0" Margin="0,0,4,0"
                    ToolTip="Class comparison" />
            <Button x:Name="XpCalculatorButton" Content="XP calc" Tag="{x:Static core:PluginKind.XpCalculator}"
                    Click="PluginButton_Click" Style="{StaticResource AppButtonStyle}" Height="30" Padding="4,0"
                    ToolTip="XP calculator" />
        </UniformGrid>
        <Grid Grid.Row="2">
            <views:XpTrackerPanel x:Name="TrackerPanel" Loaded="TrackerPanel_Loaded" />
            <Border x:Name="ClassComparisonPlaceholder" Visibility="Collapsed"
                    Style="{StaticResource SidebarCardStyle}" Padding="14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CLASS COMPARISON" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.AccentGold}" />
                    <TextBlock Text="Select an account to compare its active-class stats." TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,8,0,0" />
                    <TextBlock x:Name="ProfileStatusText" Text="" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="XpCalculatorPlaceholder" Visibility="Collapsed"
                    Style="{StaticResource SidebarCardStyle}" Padding="14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="XP CALCULATOR" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.AccentGold}" />
                    <TextBlock Text="Choose a target level for the selected account." TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
