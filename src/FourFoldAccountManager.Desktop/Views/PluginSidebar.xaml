<UserControl x:Class="FourFoldAccountManager.Desktop.Views.PluginSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A strip icon: glyph over a short label. Tag="lit" marks the open plugin with gold and a left bar. -->
        <Style x:Key="StripButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" />
                            <Rectangle x:Name="Bar" Width="3" Margin="-4,9,0,9" HorizontalAlignment="Left"
                                       RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Brush.AccentGold}"
                                       Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="lit">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentGold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The plugin list's on/off switch: a small pill, gold with the thumb on the right when on. -->
        <Style x:Key="PluginSwitchStyle" TargetType="CheckBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="Root" Width="30" Height="16" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="8" Background="{DynamicResource Brush.BorderStrong}" />
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="2" HorizontalAlignment="Left"
                                     Fill="{DynamicResource Brush.TextPrimary}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.AccentGold}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Brush.AppBackground}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PanelColumn" Width="250" />
            <ColumnDefinition x:Name="PanelGapColumn" Width="6" />
            <ColumnDefinition Width="56" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="PanelArea">
            <!-- A plugin's panel is its own card, with its own header, so it sits directly in the column. -->
            <ContentControl x:Name="PluginHost" Focusable="False" />
            <!-- The plugin list and a plugin's settings share one card with a header, drawn like the plugin panels. -->
            <Border x:Name="PageCard" Style="{StaticResource SidebarCardStyle}" Padding="14" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="2,2,2,16">
                        <Button x:Name="BackButton" Content="‹ Plugin list" Click="BackButton_Click" HorizontalAlignment="Left"
                                Height="26" Padding="8,0" Margin="0,0,0,8" Style="{StaticResource AppButtonStyle}"
                                Visibility="Collapsed" />
                        <TextBlock x:Name="KickerText" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentGold}" />
                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="9" Padding="0,8">
            <!-- StripIcons fills the space above the wrench, so a drop below the last icon moves the plugin to the bottom. -->
            <DockPanel LastChildFill="True">
                <Button x:Name="PluginListButton" DockPanel.Dock="Bottom" Margin="0" Style="{StaticResource StripButtonStyle}"
                        Click="PluginListButton_Click" ToolTip="Plugin list" AutomationProperties.Name="Plugin list" />
                <StackPanel x:Name="StripIcons" AllowDrop="True" Background="Transparent" VerticalAlignment="Stretch"
                            DragOver="StripIcons_DragOver" Drop="StripIcons_Drop" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
