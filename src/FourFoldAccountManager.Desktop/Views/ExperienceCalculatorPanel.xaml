<UserControl x:Class="FourFoldAccountManager.Desktop.Views.ExperienceCalculatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SidebarCardStyle}" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="2,2,2,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="XP CALCULATOR" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.AccentGold}" />
                    <TextBlock x:Name="AccountText" FontSize="14" FontWeight="SemiBold"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ClassText" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" Style="{StaticResource AppButtonStyle}"
                        Height="30" Padding="10,0" VerticalAlignment="Top" />
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="XP REMAINING" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock x:Name="RemainingText" Text="—" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.AccentGold}" Margin="0,3,0,0" />
                    <TextBlock Text="to target level" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TARGET LEVEL" Style="{StaticResource QuietTextStyle}" />
                    <TextBox x:Name="TargetLevelBox" TextChanged="TargetLevelBox_TextChanged"
                             Style="{StaticResource InputStyle}" Margin="0,4,8,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Apply" Click="Apply_Click" Style="{StaticResource PrimaryButtonStyle}"
                        Height="36" Padding="12,0" VerticalAlignment="Bottom" />
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="3" Text="Select an account to load its profile." TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextMuted}" Margin="2,0,2,10" />
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="CURRENT ABSOLUTE" Style="{StaticResource QuietTextStyle}" />
                        <TextBlock x:Name="CurrentAbsoluteText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TARGET ABSOLUTE" Style="{StaticResource QuietTextStyle}" />
                        <TextBlock x:Name="TargetAbsoluteText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="LevelsText" Grid.Row="1" Text="Levels remaining: —" FontSize="11"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,8" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TransitionsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LevelText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding XpText}" Foreground="{DynamicResource Brush.TextMuted}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
