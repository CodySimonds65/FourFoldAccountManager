<Window x:Class="FourFoldAccountManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FourFoldAccountManager.Desktop"
        xmlns:views="clr-namespace:FourFoldAccountManager.Desktop.Views"
        Title="FourFold Account Manager" Width="1600" Height="940"
        MinWidth="1320" MinHeight="700" WindowStartupLocation="CenterScreen"
        Icon="Assets/FourFold.ico"
        Background="{DynamicResource Brush.AppBackground}" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI" UseLayoutRounding="True" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <local:ProfileInitialConverter x:Key="ProfileInitial" />
    </Window.Resources>
    <Grid x:Name="RootLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="AppHeaderRow" Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppHeaderBorder" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Center">
                    <Image Source="Assets/FourFold.png" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="FOURFOLD" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="Account manager" Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click"
                            Style="{StaticResource AppButtonStyle}" Height="34" Padding="14,0" Margin="0,0,8,0"
                            ToolTip="Adjust how the game fits each account panel." />
                    <Button x:Name="FullScreenButton" Content="Full screen" Click="FullScreen_Click"
                            Style="{StaticResource AppButtonStyle}" Height="34" Padding="14,0"
                            ToolTip="Expand the client layout. Press Esc to return." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AccountsColumn" Width="232" />
                <ColumnDefinition x:Name="AccountsGapColumn" Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TrackerGapColumn" Width="0" />
                <ColumnDefinition x:Name="TrackerColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Border x:Name="AccountsPanel" Style="{StaticResource SidebarCardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,2,2,20">
                        <Button x:Name="AddAccountButton" DockPanel.Dock="Right" Width="34" Height="34" Padding="0"
                                Click="AddAccount_Click" Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Add an account" AutomationProperties.Name="Add account">
                            <Path Data="M0,6 H12 M6,0 V12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Accounts" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="AccountCountText" Margin="0,3,0,0" Text="0 profiles" Style="{StaticResource QuietTextStyle}" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="AccountsListBox" SelectionChanged="AccountsListBox_SelectionChanged"
                                 Style="{StaticResource ListBoxStyle}" Padding="0" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Label, Converter={StaticResource ProfileInitial}}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.AccentGold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                            <TextBlock Text="FourFold profile" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="★" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Brush.AccentGold}"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Build your party&#10;&#10;Add your first account with +" TextAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="10,26">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=AccountsListBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,14" />
                        <TextBlock Text="PROFILE OPTIONS" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" Margin="2,0,0,10" />
                        <Button x:Name="RenameAccountButton" Content="Edit profile" Click="RenameAccount_Click" IsEnabled="False"
                                Style="{StaticResource AppButtonStyle}" Height="36" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FavoriteAccountButton" Content="Favorite" Click="FavoriteAccount_Click" IsEnabled="False"
                                    Style="{StaticResource AppButtonStyle}" Padding="8,0" Height="34" Margin="0,0,6,0" />
                            <Button x:Name="MoveUpButton" Grid.Column="1" Click="MoveAccountUp_Click" IsEnabled="False"
                                    Style="{StaticResource AppButtonStyle}" Padding="0" Height="34" Margin="0,0,6,0"
                                    ToolTip="Move profile up" AutomationProperties.Name="Move profile up">
                                <Path Data="M0,5 L5,0 L10,5 M5,0 V12" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5" Width="10" Height="12" />
                            </Button>
                            <Button x:Name="MoveDownButton" Grid.Column="2" Click="MoveAccountDown_Click" IsEnabled="False"
                                    Style="{StaticResource AppButtonStyle}" Padding="0" Height="34"
                                    ToolTip="Move profile down" AutomationProperties.Name="Move profile down">
                                <Path Data="M0,7 L5,12 L10,7 M5,0 V12" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5" Width="10" Height="12" />
                            </Button>
                        </Grid>
                        <Button x:Name="RemoveAccountButton" Content="Remove profile…" Click="RemoveAccount_Click" IsEnabled="False"
                                Style="{StaticResource DangerButtonStyle}" Height="32" Margin="0,8,0,0" Padding="8,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Profiles saved on this PC" FontSize="10" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,18,0,2" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="PanelToolbar" Margin="4,2,4,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ToggleAccountsButton" Width="34" Height="34" Padding="0" Margin="0,0,12,0"
                            Click="ToggleAccountsPanel_Click" Style="{StaticResource AppButtonStyle}"
                            ToolTip="Hide accounts" AutomationProperties.Name="Toggle accounts sidebar">
                        <Path Data="M0,0 H16 V14 H0 Z M5,0 V14" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.3"
                              Width="16" Height="14" Stretch="Uniform" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="WorkspaceViewButton" Content="Workspace" Click="WorkspaceView_Click"
                                    Style="{StaticResource AppButtonStyle}" Height="34" Padding="14,0"
                                    Margin="0,0,7,0" />
                            <Button x:Name="LeaderboardViewButton" Content="Leaderboard" Click="LeaderboardView_Click"
                                    Style="{StaticResource AppButtonStyle}" Height="34" Padding="14,0" />
                        </StackPanel>
                        <TextBlock x:Name="ViewSubtitle" Text="Your accounts, together." FontSize="11"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="WorkspaceControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AdjustViewsButton" Content="Adjust views" Click="AdjustViews_Click" Visibility="Collapsed"
                                Style="{StaticResource AppButtonStyle}" Height="36" Padding="10,0" Margin="0,0,8,0"
                                ToolTip="Resize each active game within its account panel" />
                        <Button x:Name="ManageSlotsButton" Content="Manage slots" Click="ManageSlots_Click" Visibility="Collapsed"
                                Style="{StaticResource AppButtonStyle}" Height="36" Padding="10,0" Margin="0,0,8,0" ToolTip="Change account assignments" />
                        <ComboBox x:Name="LayoutPicker" Width="190" Height="36" Margin="0,0,8,0"
                                  Style="{StaticResource ComboBoxStyle}" ItemTemplate="{StaticResource ChoiceLabelTemplate}"
                                  SelectionChanged="LayoutPicker_SelectionChanged" AutomationProperties.Name="Panel layout" />
                        <Button x:Name="LaunchVisibleButton" MinWidth="144" Height="36" Padding="16,0"
                                Content="Launch accounts" Click="LaunchVisible_Click" Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Starts missing or failed assigned sessions; healthy open sessions stay open." />
                        <Button x:Name="TogglePluginsButton" Width="34" Height="34" Padding="0" Margin="12,0,0,0"
                                Click="TogglePluginsPanel_Click" Style="{StaticResource AppButtonStyle}" IsEnabled="False"
                                ToolTip="Hide the plugins sidebar to expand the multi-box panel."
                                AutomationProperties.Name="Toggle plugins sidebar">
                            <Path Data="M0,0 H16 V14 H0 Z M11,0 V14" Stroke="{DynamicResource Brush.TextSecondary}"
                                  StrokeThickness="1.3" Width="16" Height="14" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Border x:Name="PanelBorder" Grid.Row="1" Padding="0" CornerRadius="0" BorderThickness="0"
                        Background="{DynamicResource Brush.AppBackground}">
                    <Grid>
                        <Grid x:Name="PanelGridHost" />
                        <views:LeaderboardPanel x:Name="LeaderboardPanelView" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <TextBlock x:Name="GlobalStatusText" Grid.Row="2" Margin="6,10,6,0" Style="{StaticResource QuietTextStyle}"
                           Text="Add an account to get started." TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
            <views:PluginSidebar x:Name="PluginSidebar" Grid.Column="4" Visibility="Collapsed" />
        </Grid>
        <Grid x:Name="MaintenanceWebViewHost" Width="2" Height="2" Opacity="0" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Button x:Name="FullScreenExitButton" Panel.ZIndex="1000" Grid.RowSpan="2" Width="74" Height="34" Margin="10"
                HorizontalAlignment="Right" VerticalAlignment="Top" Content="Exit" Click="FullScreenExit_Click"
                Visibility="Collapsed" Opacity="0.78" Style="{StaticResource AppButtonStyle}" ToolTip="Exit full screen (Esc)"
                MouseEnter="FullScreenExit_MouseEnter" MouseLeave="FullScreenExit_MouseLeave" />
        <views:OverlayCardLayer x:Name="GlobalOverlayLayer" Grid.RowSpan="2" Panel.ZIndex="800" />
        <views:FullscreenOverlayTray x:Name="FullscreenOverlayTray" Grid.RowSpan="2" Panel.ZIndex="900"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
    </Grid>
</Window>
